digraph silver {
  graph [rankdir=LR, nodesep=0.35, ranksep=0.9, bgcolor="white", fontname="Helvetica"];
  node  [shape=plain, fontname="Helvetica", fontsize=11];
  edge  [color="#555555", arrowhead=normal, arrowtail=crow, dir=both, fontname="Helvetica", fontsize=9];
  region [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="3" bgcolor="#1F3A5F"><font color="white"><b>region</b></font></td></tr><tr><td align="left" port="region_key"><b>region_key</b></td><td align="left"><font color="#666666">bigint</font></td><td><font color="#B8500C">PK</font></td></tr><tr><td align="left" port="name">name</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="comment">comment</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr></table>>];
  nation [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="3" bgcolor="#1F3A5F"><font color="white"><b>nation</b></font></td></tr><tr><td align="left" port="nation_key"><b>nation_key</b></td><td align="left"><font color="#666666">bigint</font></td><td><font color="#B8500C">PK</font></td></tr><tr><td align="left" port="name">name</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="region_key">region_key</td><td align="left"><font color="#666666">bigint</font></td><td><font color="#B8500C">FK</font></td></tr><tr><td align="left" port="comment">comment</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr></table>>];
  customer [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="3" bgcolor="#1F3A5F"><font color="white"><b>customer</b></font></td></tr><tr><td align="left" port="customer_key"><b>customer_key</b></td><td align="left"><font color="#666666">bigint</font></td><td><font color="#B8500C">PK</font></td></tr><tr><td align="left" port="name">name</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="address">address</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="nation_key">nation_key</td><td align="left"><font color="#666666">bigint</font></td><td><font color="#B8500C">FK</font></td></tr><tr><td align="left" port="phone">phone</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="account_balance">account_balance</td><td align="left"><font color="#666666">decimal(18,2)</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="market_segment">market_segment</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="comment">comment</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr></table>>];
  supplier [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="3" bgcolor="#1F3A5F"><font color="white"><b>supplier</b></font></td></tr><tr><td align="left" port="supplier_key"><b>supplier_key</b></td><td align="left"><font color="#666666">bigint</font></td><td><font color="#B8500C">PK</font></td></tr><tr><td align="left" port="name">name</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="address">address</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="nation_key">nation_key</td><td align="left"><font color="#666666">bigint</font></td><td><font color="#B8500C">FK</font></td></tr><tr><td align="left" port="phone">phone</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="account_balance">account_balance</td><td align="left"><font color="#666666">decimal(18,2)</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="comment">comment</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr></table>>];
  part [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="3" bgcolor="#1F3A5F"><font color="white"><b>part</b></font></td></tr><tr><td align="left" port="part_key"><b>part_key</b></td><td align="left"><font color="#666666">bigint</font></td><td><font color="#B8500C">PK</font></td></tr><tr><td align="left" port="name">name</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="manufacturer">manufacturer</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="brand">brand</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="type">type</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="size">size</td><td align="left"><font color="#666666">int</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="container">container</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="retail_price">retail_price</td><td align="left"><font color="#666666">decimal(18,2)</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="comment">comment</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr></table>>];
  partsupp [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="3" bgcolor="#1F3A5F"><font color="white"><b>partsupp</b></font></td></tr><tr><td align="left" port="part_key"><b>part_key</b></td><td align="left"><font color="#666666">bigint</font></td><td><font color="#B8500C">PK/FK</font></td></tr><tr><td align="left" port="supplier_key"><b>supplier_key</b></td><td align="left"><font color="#666666">bigint</font></td><td><font color="#B8500C">PK/FK</font></td></tr><tr><td align="left" port="available_quantity">available_quantity</td><td align="left"><font color="#666666">int</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="supply_cost">supply_cost</td><td align="left"><font color="#666666">decimal(18,2)</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="comment">comment</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr></table>>];
  orders [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="3" bgcolor="#1F3A5F"><font color="white"><b>orders</b></font></td></tr><tr><td align="left" port="order_key"><b>order_key</b></td><td align="left"><font color="#666666">bigint</font></td><td><font color="#B8500C">PK</font></td></tr><tr><td align="left" port="customer_key">customer_key</td><td align="left"><font color="#666666">bigint</font></td><td><font color="#B8500C">FK</font></td></tr><tr><td align="left" port="order_status">order_status</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="total_price">total_price</td><td align="left"><font color="#666666">decimal(18,2)</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="order_date">order_date</td><td align="left"><font color="#666666">date</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="order_priority">order_priority</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="clerk">clerk</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="ship_priority">ship_priority</td><td align="left"><font color="#666666">int</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="comment">comment</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr></table>>];
  lineitem [label=<<table border="1" cellborder="0" cellspacing="0" cellpadding="3"><tr><td colspan="3" bgcolor="#1F3A5F"><font color="white"><b>lineitem</b></font></td></tr><tr><td align="left" port="order_key"><b>order_key</b></td><td align="left"><font color="#666666">bigint</font></td><td><font color="#B8500C">PK/FK</font></td></tr><tr><td align="left" port="line_number"><b>line_number</b></td><td align="left"><font color="#666666">int</font></td><td><font color="#B8500C">PK</font></td></tr><tr><td align="left" port="part_key">part_key</td><td align="left"><font color="#666666">bigint</font></td><td><font color="#B8500C">FK</font></td></tr><tr><td align="left" port="supplier_key">supplier_key</td><td align="left"><font color="#666666">bigint</font></td><td><font color="#B8500C">FK</font></td></tr><tr><td align="left" port="quantity">quantity</td><td align="left"><font color="#666666">decimal(18,2)</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="extended_price">extended_price</td><td align="left"><font color="#666666">decimal(18,2)</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="discount">discount</td><td align="left"><font color="#666666">decimal(18,2)</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="tax">tax</td><td align="left"><font color="#666666">decimal(18,2)</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="return_flag">return_flag</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="line_status">line_status</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="ship_date">ship_date</td><td align="left"><font color="#666666">date</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="commit_date">commit_date</td><td align="left"><font color="#666666">date</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="receipt_date">receipt_date</td><td align="left"><font color="#666666">date</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="ship_instructions">ship_instructions</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="ship_mode">ship_mode</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr><tr><td align="left" port="comment">comment</td><td align="left"><font color="#666666">string</font></td><td><font color="#B8500C"> </font></td></tr></table>>];
  nation -> region [label="region_key"];
  customer -> nation [label="nation_key"];
  supplier -> nation [label="nation_key"];
  partsupp -> part [label="part_key"];
  partsupp -> supplier [label="supplier_key"];
  orders -> customer [label="customer_key"];
  lineitem -> orders [label="order_key"];
  lineitem -> partsupp [label="part_key, supplier_key"];
}